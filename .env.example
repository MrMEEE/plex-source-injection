PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=your_plex_token_here
MUSIC_SECTION_ID=1
DOWNLOAD_DIR=/music/Downloads
# Path of DOWNLOAD_DIR as seen by Plex Media Server (defaults to DOWNLOAD_DIR)
# PLEX_DOWNLOAD_DIR=/music/Downloads
RETENTION_DAYS=30
PROXY_PORT=8080

# Enabled Providers
ENABLED_PROVIDERS=youtube,spotify

# Provider Credentials
SPOTIFY_CLIENT_ID=your_id
SPOTIFY_CLIENT_SECRET=your_secret
YOUTUBE_API_KEY=your_optional_key

# Optional tuning
# AUDIO_FORMAT=mp3
# SEARCH_LIMIT=10
# PROVIDER_TIMEOUT=8
# DOWNLOAD_TIMEOUT=300
# SCAN_TIMEOUT=120
# SCAN_POLL_INTERVAL=2
# CLEANUP_INTERVAL_HOURS=24
# SPOTDL_BINARY=spotdl
